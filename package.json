{
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "kakao:setup": "node scripts/kakao-test/setup.mjs",
    "kakao:db": "docker compose --env-file .env.local -f compose.kakao-test.yml up -d --wait",
    "kakao:migrate": "node --env-file=.env.local scripts/kakao-test/migrate.mjs",
    "kakao:evidence": "node --env-file=.env.local scripts/kakao-test/evidence.mjs",
    "kakao:dev": "next dev --webpack --hostname localhost --port 3000",
    "test:kakao": "node --env-file=.env.local --test tests/kakao-test/*.test.ts",
    "auth-migration:setup": "node scripts/auth-migration/setup.mjs",
    "auth-migration:db": "docker compose --env-file .env.local -f compose.auth-migration.yml up -d --wait",
    "auth-migration:snapshot": "node --env-file=.env.local scripts/auth-migration/snapshot.mjs",
    "test:auth-migration": "node --env-file=.env.local --test tests/auth-migration/*.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "autoprefixer": "10.5.6",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jotai": "^2.20.3",
    "libphonenumber-js": "1.13.13",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3"
  }
}
