# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# 개발 전용 Better Auth / 카카오 검증. pnpm kakao:setup으로 .env.local을 준비한다.
# 이 기능은 NODE_ENV=production에서 항상 비활성화된다.
KAKAO_AUTH_TEST_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_APP_ID=
BETTER_AUTH_SECRET=
KAKAO_TEST_DB_PASSWORD=
KAKAO_TEST_DATABASE_URL=
